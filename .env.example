GEMINI_API_KEY=put_your_key_here
# מפתחות Gemini מרובים (אופציונלי): רשימה מופרדת בפסיקים, בסדר ההעדפה. כשמוגדר, הוא גובר על GEMINI_API_KEY הבודד.
# מפתח שמכסתו נגמרה (429 יומי), או שנכשל בעומס (503/504/timeout) אחרי הניסיונות החוזרים, או שנדחה באימות (401/403)
# מעביר למפתח הבא. מכסה יומית נספרת לכל מפתח בנפרד (data/quota_state_key2.json וכו').
# GEMINI_API_KEYS=key_one,key_two,key_three
# גיבוי אחרון ב-Claude: כשכל מפתחות Gemini והניסיונות החוזרים נכשלו, העמוד נקרא ב-Claude (אותה הוראה ואותה סכמה).
# שימו לב: זה שולח את תמונת העמוד לספק נוסף (Anthropic). בשימוש אמיתי צריך חוזה/מודל פרטי מאושר לשני הספקים.
# ANTHROPIC_API_KEY=put_your_anthropic_key_here
# CLAUDE_FALLBACK=1      # 0 מכבה את הגיבוי גם כשיש מפתח
# ANTHROPIC_BUDGET_USD=2.0   # תקרת הוצאה מוערכת לריצה (חל גם על הגיבוי)
# הגדרת המודלים נמצאת ב-config/models.json (לא כאן)

# PRIVACY_MODE: dev (ברירת מחדל כשהמשתנה חסר) או production.
#   dev        = העבודה שלנו, עם נתונים מזויפים: מטמון תשובות המודל (data/cache/) וקבצי דיבוג (חיתוכים, p<N>.json) פעילים.
#   production = מה שהמעבדה מריצה על מטופלים אמיתיים: שום דבר על המטופל לא נכתב לדיסק מעבר לסשן.
#                בלי מטמון, בלי קבצי דיבוג. התוצאות נשארות בזיכרון בלבד, בשביל הטבלה וקובץ האקסל שמורידים.
# ערך אחר (שגיאת כתיב) נחשב production, כדי שטעות תיכשל לצד הבטוח.
PRIVACY_MODE=dev
