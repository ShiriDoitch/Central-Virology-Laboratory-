GEMINI_API_KEY=put_your_key_here
# הגדרת המודלים נמצאת ב-config/models.json (לא כאן)

# PRIVACY_MODE: dev (ברירת מחדל כשהמשתנה חסר) או production.
#   dev        = העבודה שלנו, עם נתונים מזויפים: מטמון תשובות המודל (data/cache/) וקבצי דיבוג (חיתוכים, p<N>.json) פעילים.
#   production = מה שהמעבדה מריצה על מטופלים אמיתיים: שום דבר על המטופל לא נכתב לדיסק מעבר לסשן.
#                בלי מטמון, בלי קבצי דיבוג. התוצאות נשארות בזיכרון בלבד, בשביל הטבלה וקובץ האקסל שמורידים.
# ערך אחר (שגיאת כתיב) נחשב production, כדי שטעות תיכשל לצד הבטוח.
PRIVACY_MODE=dev
